import os
import glob
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
import torchvision.io as io
from movinets import MoViNet
from movinets.config import _C

# =====================================================================
# 1. CONFIGURATION & HYPERPARAMETERS
# =====================================================================
CONFIG = {
    "num_classes": 3,           # Total custom classes (e.g., action_1, action_2, background)
    "batch_size": 8,            # Batch size (8 is optimal for 8GB–12GB VRAM GPUs)
    "learning_rate": 1e-4,      # Fine-tuning learning rate
    "weight_decay": 1e-2,       # AdamW weight decay regularization
    "num_epochs": 15,           # Total training epochs
    "num_frames": 15,           # 1.5 seconds @ 10 FPS = 15 frames
    "train_dir": "data/dataset/train",
    "val_dir": "data/dataset/val",
    "save_path": "checkpoints/best_movinet_a2_stream.pt"
}

DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")


# =====================================================================
# 2. CUSTOM DATASET LOADER
# =====================================================================
class VideoClipDataset(Dataset):
    """
    Loads 1.5-second subclips (15 frames) from class folders:
    root_dir/
      ├── action_1/
      ├── action_2/
      └── background/
    """
    def __init__(self, root_dir, target_frames=15):
        self.clip_paths = glob.glob(os.path.join(root_dir, "*", "*.mp4"))
        self.classes = sorted(list(set([os.path.basename(os.path.dirname(p)) for p in self.clip_paths])))
        self.class_to_idx = {cls_name: i for i, cls_name in enumerate(self.classes)}
        self.target_frames = target_frames

    def __len__(self):
        return len(self.clip_paths)

    def __getitem__(self, idx):
        clip_path = self.clip_paths[idx]
        class_name = os.path.basename(os.path.dirname(clip_path))
        label = self.class_to_idx[class_name]

        # Read video as uint8 tensor [Frames, Height, Width, Channels]
        video, _, _ = io.read_video(clip_path, pts_unit='sec')

        # Permute to [Channels, Frames, Height, Width] & normalize to float [0, 1]
        video = video.permute(3, 0, 1, 2).float() / 255.0

        # Pad or slice to enforce exact target frame length (15 frames)
        c, t, h, w = video.shape
        if t > self.target_frames:
            video = video[:, :self.target_frames, :, :]
        elif t < self.target_frames:
            pad = torch.zeros((c, self.target_frames - t, h, w))
            video = torch.cat([video, pad], dim=1)

        return video, torch.tensor(label, dtype=torch.long)


# =====================================================================
# 3. MODEL SETUP & LAYER FREEZING
# =====================================================================
def create_movinet_a2_stream(num_classes):
    # 1. Load MoViNet-A2 with Causal Streaming and Pretrained Kinetics Weights
    model = MoViNet(_C.MODEL.MoViNetA2, causal=True, pretrained=True)

    # 2. Replace Classifier Head for Custom Class Count
    model.classifier[0] = nn.Conv3d(
        in_channels=model.classifier[0].in_channels,
        out_channels=_C.MODEL.MoViNetA2.conv_1.out_planes,
        kernel_size=(1, 1, 1)
    )
    model.classifier[3] = nn.Conv3d(
        in_channels=_C.MODEL.MoViNetA2.conv_1.out_planes,
        out_channels=num_classes,
        kernel_size=(1, 1, 1)
    )

    # 3. Freeze Stem & Stages 0 and 1 (Keep Stage 2+ Trainable)
    for name, param in model.named_parameters():
        if "blocks.0" in name or "blocks.1" in name or "conv1" in name:
            param.requires_grad = False
        else:
            param.requires_grad = True

    return model


# =====================================================================
# 4. TRAINING & VALIDATION ENGINES
# =====================================================================
def train_epoch(model, loader, criterion, optimizer, device):
    model.train()
    running_loss, correct, total = 0.0, 0, 0

    for clips, labels in loader:
        clips, labels = clips.to(device), labels.to(device)

        # MANDATORY: Clear temporal hidden state buffers before batch forward pass
        model.clean_activation_buffers()

        optimizer.zero_grad()
        outputs = model(clips)
        loss = criterion(outputs, labels)
        loss.backward()
        optimizer.step()

        # Clean buffers after gradient step
        model.clean_activation_buffers()

        running_loss += loss.item() * clips.size(0)
        preds = torch.argmax(outputs, dim=1)
        correct += torch.sum(preds == labels).item()
        total += labels.size(0)

    return running_loss / total, correct / total


def eval_epoch(model, loader, criterion, device):
    model.eval()
    running_loss, correct, total = 0.0, 0, 0

    with torch.no_grad():
        for clips, labels in loader:
            clips, labels = clips.to(device), labels.to(device)

            model.clean_activation_buffers()
            outputs = model(clips)
            loss = criterion(outputs, labels)
            model.clean_activation_buffers()

            running_loss += loss.item() * clips.size(0)
            preds = torch.argmax(outputs, dim=1)
            correct += torch.sum(preds == labels).item()
            total += labels.size(0)

    return running_loss / total, correct / total


# =====================================================================
# 5. MAIN EXECUTION PIPELINE
# =====================================================================
def main():
    os.makedirs(os.path.dirname(CONFIG["save_path"]), exist_ok=True)
    print(f"Executing on device: {DEVICE}")

    # 1. Prepare Data Loaders
    train_dataset = VideoClipDataset(CONFIG["train_dir"], target_frames=CONFIG["num_frames"])
    val_dataset = VideoClipDataset(CONFIG["val_dir"], target_frames=CONFIG["num_frames"])

    train_loader = DataLoader(train_dataset, batch_size=CONFIG["batch_size"], shuffle=True, num_workers=2, pin_memory=True)
    val_loader = DataLoader(val_dataset, batch_size=CONFIG["batch_size"], shuffle=False, num_workers=2, pin_memory=True)

    print(f"Dataset Loaded: {len(train_dataset)} train clips | {len(val_dataset)} val clips | {len(train_dataset.classes)} classes.")

    # 2. Instantiate Model
    model = create_movinet_a2_stream(CONFIG["num_classes"]).to(DEVICE)

    # 3. Setup Optimizer, Cosine Scheduler, & Criterion
    trainable_params = filter(lambda p: p.requires_grad, model.parameters())
    optimizer = torch.optim.AdamW(trainable_params, lr=CONFIG["learning_rate"], weight_decay=CONFIG["weight_decay"])
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=CONFIG["num_epochs"])
    criterion = nn.CrossEntropyLoss(label_smoothing=0.1)

    # 4. Training Loop
    best_val_acc = 0.0
    for epoch in range(1, CONFIG["num_epochs"] + 1):
        train_loss, train_acc = train_epoch(model, train_loader, criterion, optimizer, DEVICE)
        val_loss, val_acc = eval_epoch(model, val_loader, criterion, DEVICE)
        scheduler.step()

        print(f"Epoch [{epoch:02d}/{CONFIG['num_epochs']:02d}] | "
              f"Train Loss: {train_loss:.4f} - Acc: {train_acc*100:.2f}% | "
              f"Val Loss: {val_loss:.4f} - Acc: {val_acc*100:.2f}%")

        # Save Best Checkpoint
        if val_acc > best_val_acc:
            best_val_acc = val_acc
            torch.save(model.state_dict(), CONFIG["save_path"])
            print(f"  --> Saved new best checkpoint to '{CONFIG['save_path']}' (Val Acc: {val_acc*100:.2f}%)")

    print(f"\nTraining Complete! Best Validation Accuracy: {best_val_acc*100:.2f}%")


if __name__ == "__main__":
    main()
